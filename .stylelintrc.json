{
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "declaration-property-value-disallowed-list": {
      "/.*/": ["/^rgba?\\(\\s*\\d/", "/^hsla?\\(/", "/\\brgba?\\(\\s*\\d/", "/\\bhsla?\\(/"]
    }
  },
  "overrides": [
    {
      "files": ["src/shared/styles/tokens.css", "src/shared/styles/themes/*.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
